# =============================================================================
# CDC Portal API - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# Run: php artisan key:generate after copying

APP_NAME="CDC Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ------------------------------
# Database Configuration
# ------------------------------
# SQLite (Development)
DB_CONNECTION=sqlite
DB_DATABASE=/absolute/path/to/database.sqlite

# MySQL/MariaDB (Production)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cdc_portal
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=file

# Redis (Production - uncomment if using Redis)
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# REDIS_CLIENT=predis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ------------------------------
# File Storage
# ------------------------------
FILESYSTEM_DISK=public

# AWS S3 (Production)
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=your-bucket
# AWS_USE_PATH_STYLE_ENDPOINT=false

# MinIO (Self-hosted S3-compatible)
# FILESYSTEM_DISK=s3
# AWS_ENDPOINT=http://localhost:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# ------------------------------
# Email Configuration
# ------------------------------
# Development: Logs to storage/logs/mail.log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="cdc@iitism.ac.in"
MAIL_FROM_NAME="IIT (ISM) CDC"

# Production SMTP Example
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=587
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_ENCRYPTION=tls

# AWS SES (Production)
# MAIL_MAILER=ses

# ------------------------------
# Sanctum / CORS
# ------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000,127.0.0.1:3000,127.0.0.1:8000
FRONTEND_URL=http://localhost:3000

# ------------------------------
# Frontend Build
# ------------------------------
VITE_API_URL=http://localhost:8000/api
